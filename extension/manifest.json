{
  "manifest_version": 3,
  "name": "PostPilot AI — Capture to Drafts",
  "version": "1.0.0",
  "description": "Save any selected text from the web straight into your PostPilot AI drafts.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "notifications"],
  "host_permissions": [
    "https://getpostpilot.vercel.app/*",
    "https://*.supabase.co/*"
  ]
}
